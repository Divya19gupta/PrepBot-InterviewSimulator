datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id        String   @id
  currentIndex Int @default(0)
  userId    String
  name      String
  email     String
  language  String
  status    String   @default("in_progress")

  currentPrototype String // "A" | "B"
  phaseCompleted   Int    @default(0) // 0,1,2

  answers   Answer[]
  createdAt DateTime @default(now())
}

model Answer {
  id          Int      @id @default(autoincrement())
  sessionId   String
  question    String
  transcript  String?
  feedback    String?
  audioFile   String
  attempts    Int      @default(1)
  createdAt   DateTime @default(now())
  prototype   String

  confidence           Float?     // avg ASR confidence
  lowConfidenceWords   Json?      // array of words
  lowConfidenceRatio   Float?
  editedTranscript     String?    // for later feature (optional but good)

  session Session @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, question, prototype])
}

model PhaseFeedback {
  id        Int      @id @default(autoincrement())
  sessionId String
  prototype String

  accuracy      Int
  fairness      Int
  understanding Int
  blame         String

  createdAt DateTime @default(now())
}