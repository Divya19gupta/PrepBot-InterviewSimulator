datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id           String   @id
  currentIndex Int      @default(0)
  userId       String
  name         String
  email        String
  language     String
  status       String   @default("in_progress")

  answers   Answer[]
  createdAt DateTime @default(now())
}

model Answer {
  id        Int      @id @default(autoincrement())
  sessionId String
  questionIndex Int
  question  String

  transcript String?
  assemblyTranscriptId  String?

  // 🔥 SYSTEM OUTPUT
  feedbackA String?
  feedbackB String?
  wrongFeedbackType String?
  wrongErrorType   String?
  wrongExplanation String?

  // 🔥 USER STUDY DATA
  trustChoice    String?
  relianceChoice String?
  fairnessChoice String?
  blameTarget    String?
  confidenceUsed Boolean?

  // 🔥 ADD THESE (CRITICAL FOR RQs)
  clarity       String?
  understanding String?
  bias          String?
  trustReason   String?

  // 🔥 AUDIO + ATTEMPTS
  audioFile String
  attempts  Int      @default(1)

  // 🔥 ASR METRICS
  confidence           Float?
  lowConfidenceWords   Json?
  lowConfidenceRatio   Float?

  viewedFeedbackA Boolean @default(false)
  viewedFeedbackB Boolean @default(false)

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, questionIndex])
}