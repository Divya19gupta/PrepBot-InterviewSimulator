datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id           String   @id
  currentIndex Int      @default(0)
  userId       String
  participantId String  @unique
  language     String

  experimentVersion String
  wrongnessImplementation String
  structureCriteria String[]

  intentCriteria String[]
  status       String   @default("in_progress")

  answers   Answer[]
  createdAt DateTime @default(now())
}

model Answer {
  id        Int      @id @default(autoincrement())
  sessionId String
  questionIndex Int
  question  String

  transcript String?
  assemblyTranscriptId String?

  feedbackA String?
  feedbackB String?
  wrongExplanation String?

  uncertainty String?
  errorCondition String?

  trustChoice Int?
  blameTarget Int?
  selfCompetence Int?
  reengageIntent Int?
  perceivedAccuracy Int?
  feedbackAUsefulness Int?
  feedbackBUsefulness Int?
  uncertaintyInfluence Int?
  
  uncertaintyBuffer String?

  audioFile String
  attempts Int @default(1)

  confidence Float?
  lowConfidenceWords Json?
  lowConfidenceRatio Float?

  viewedFeedbackA Boolean @default(false)
  viewedFeedbackB Boolean @default(false)

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, questionIndex])
}